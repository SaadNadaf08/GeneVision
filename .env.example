# Copy this file to .env. Keep .env private; never commit or share it.
GENEVISION_API_PORT=4173
HOST=127.0.0.1

# Optional: NCBI E-utilities asks higher-volume clients to identify themselves.
NCBI_EMAIL=
NCBI_API_KEY=

# AI tutor uses an OpenAI-compatible Chat Completions endpoint.
# Add your provider's key locally in .env; it is only read by the server.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
